msgid ""
"New here? <a href=\"%(tracks_url)s\">How to read the rolls</a> &middot; <a href=\"%(plan_url)s\">How to plan</a>"
msgstr ""
"처음이라면? <a href=\"%(tracks_url)s\">배열 보는 법</a> &middot; <a href=\"%(plan_url)s\">계획 세우는 법</a>"

#: .\templates\planner\planner.html:17
msgid "required"
msgstr "필수"

#: .\templates\planner\planner.html:17
